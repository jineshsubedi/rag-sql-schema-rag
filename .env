# Target Host PostgreSQL Configuration
# host.docker.internal allows Docker containers to talk to PostgreSQL running on the host OS
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/postgres

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Qdrant Configuration
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=schema_rag

# Connection Pooling Settings
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10

# Streamlit Backend Connection
BACKEND_URL=http://backend:8000
